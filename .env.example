PORT=3000
NODE_ENV=development

DATABASE_PATH=./data/wifi-portal.db

ADMIN_SESSION_SECRET=change-this-to-at-least-32-characters

LOG_LEVEL=info

# RADIUS. In production, only these NAS/router source IPs can send packets.
RADIUS_SHARED_SECRET=replace-with-a-long-random-secret
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
# Standard CoA uses 3799. MikroTik RouterOS defaults /radius incoming to 1700;
# use either value, but set the same port here and on the router.
RADIUS_COA_PORT=3799
# Keep this equal to the MikroTik HotSpot Profile's Interim Update value.
# 10 seconds gives the dashboard a near-real-time speed average without
# creating the write load of per-second RADIUS Accounting.
RADIUS_INTERIM_INTERVAL_SECONDS=10
RADIUS_CLIENTS=192.168.88.1

# The policy database used by FreeRADIUS. Docker Compose supplies this value
# automatically for its portal service; set it when running Node directly.
RADIUS_DATABASE_URL=mysql://radius:change-this-radius-db-password@127.0.0.1:3306/radius
RADIUS_DB_PASSWORD=change-this-radius-db-password
MARIADB_ROOT_PASSWORD=change-this-separate-strong-root-password
