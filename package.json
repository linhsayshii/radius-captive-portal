{
  "name": "wifi-portal",
  "version": "1.0.0",
  "description": "WiFi Captive Portal with RADIUS",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:portal": "vite",
    "build:portal": "vite build",
    "dev:admin": "vite --config vite.admin.config.mts",
    "build:admin": "vite build --config vite.admin.config.mts",
    "clean:portal-assets": "node scripts/clean-frontend-assets.js portal",
    "clean:admin-assets": "node scripts/clean-frontend-assets.js admin",
    "prebuild:portal": "npm run clean:portal-assets",
    "prebuild:admin": "npm run clean:admin-assets",
    "check:portal": "tsc --project tsconfig.app.json",
    "test:core": "node scripts/test-core-workflow.js",
    "test:rate-limits": "node scripts/test-rate-limits.js",
    "init-db": "node scripts/init-db.js",
    "create-admin": "node scripts/create-admin.js",
    "setup-sample-data": "node scripts/setup-sample-data.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "lucide-react": "^1.34.0",
    "mysql2": "^3.24.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "nodemon": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
