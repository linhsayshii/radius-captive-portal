    "clsx": "^2.1.1",
    "connect-sqlite3": "^0.9.15",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "lucide-react": "^1.34.0",
